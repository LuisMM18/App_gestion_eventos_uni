<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".OpcionesLogin">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:src="@drawable/email"
            android:contentDescription="Email Login Icon" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/Ingresar_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/m_button_height"
            android:text="@string/Ingresar_email"
            android:textAllCaps="true"
            app:cornerRadius="8dp" />

        <ImageView
            android:layout_width="50dp"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/google"
            android:contentDescription="Google Login Icon" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/Ingresar_google"
            android:layout_width="match_parent"
            android:layout_height="@dimen/m_button_height"
            android:text="@string/Ingresar_google"
            android:textAllCaps="true"
            app:cornerRadius="8dp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</RelativeLayout>
